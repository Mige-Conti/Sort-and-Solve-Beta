      value: 0.02
      objectReference: {fileID: 0}
    - target: {fileID: 5462932002807606817, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
      propertyPath: guion.Array.data[0].texto
      value: "\xA1Alerta m\xE1xima, Jack! Estoy detectando altos niveles de radiaci\xF3n
        y toxicidad en el \xE1rea."
      objectReference: {fileID: 0}
    - target: {fileID: 5462932002807606817, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
      propertyPath: guion.Array.data[1].texto
      value: "Ese \xE1cido derretir\xE1 los contenedores al instante. Calcula tu
        ruta con extrema precauci\xF3n."
      objectReference: {fileID: 0}
    - target: {fileID: 5462932002807606817, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
      propertyPath: guion.Array.data[2].texto
      value: "Y ten cuidado con la fauna mutante... Esas ratas son agresivas, pero
        sus patrones de patrulla son predecibles. \xA1Anticipa sus movimientos!"
      objectReference: {fileID: 0}
    - target: {fileID: 5462932002807606817, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
      propertyPath: guion.Array.data[0].poseKate
