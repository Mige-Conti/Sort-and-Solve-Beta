--- !u!1001 &2014846772
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 5221066548609874241, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
      propertyPath: m_Name
      value: UI_DialogosKate
      objectReference: {fileID: 0}
    - target: {fileID: 5462932002807606817, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
      propertyPath: guion.Array.data[0].texto
      value: "Atento, Jack. El esc\xE1ner muestra anomal\xEDas estructurales en esta
        sala."
      objectReference: {fileID: 0}
    - target: {fileID: 5462932002807606817, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
      propertyPath: guion.Array.data[1].texto
      value: "Esos agujeros profundos destruir\xE1n cualquier objeto que caiga en
        ellos. Mant\xE9n las cajas alejadas del borde."
      objectReference: {fileID: 0}
    - target: {fileID: 5462932002807606817, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
      propertyPath: guion.Array.data[2].texto
      value: "Para avanzar, deber\xE1s usar algunas piedras para activar las placas
        de presi\xF3n del suelo. Eso abrir\xE1 las puertas de seguridad."
      objectReference: {fileID: 0}
    - target: {fileID: 5462932002807606817, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
      propertyPath: guion.Array.data[0].poseKate
      value: 
      objectReference: {fileID: 5437008150470902363, guid: bf5794dc1be58ea4db3b0da881c22c4e, type: 3}
    - target: {fileID: 5462932002807606817, guid: 788f3a9bd6043ef4183df40bfefcff30, type: 3}
