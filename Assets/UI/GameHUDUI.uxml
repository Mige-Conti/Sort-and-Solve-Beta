<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameHUDStyle.uss?fileID=7433441132597879392&amp;guid=9708a8d02f4d39341be12e4796a76918&amp;type=3#GameHUDStyle"/>
    <ui:Button text="||" name="BtnPausa" style="align-self: flex-end; width: 35px; height: 35px;"/>
    <ui:VisualElement name="PanelPausa" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.471); align-self: auto; align-items: flex-start; -unity-text-align: upper-left; justify-content: center; position: absolute;">
        <ui:VisualElement name="ContenedorPausaLateral" style="flex-grow: 1;">
            <ui:VisualElement name="BotonesPausa" style="flex-grow: 1;">
                <ui:Label text="Juego Pausado" style="-unity-text-outline-color: rgb(0, 0, 0); font-size: 24px; -unity-font-style: bold; align-self: center; color: rgb(255, 255, 255); -unity-text-align: upper-center;"/>
                <ui:Button text="Reanudar" name="BtnReanudar"/>
                <ui:Button text="Reiniciar Nivel" name="BtnReiniciar" emoji-fallback-support="true"/>
                <ui:Button text="Ajustes" name="BtnAjustesPausa"/>
                <ui:Button text="Menú Principal" name="BtnMenuPrincipal"/>
            </ui:VisualElement>
            <ui:VisualElement name="PanelAjustesPausa" style="flex-grow: 1;">
                <ui:Label text="AJUSTES DE AUDIO"/>
                <ui:Slider label="Música" value="100" high-value="100" name="SldVolumenMusica"/>
                <ui:Slider label="Efectos" value="100" high-value="100" name="SldVolumenEfectos"/>
                <ui:Button text="Retroceder" name="BtnVolverAjustes"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PanelVictoria" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
        <ui:VisualElement name="VictoriaKateContenedor" style="flex-grow: 1;">
            <ui:VisualElement name="RetratoKateVictoria" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Dialogos/Kate_Victoria.png?fileID=-7081969147552719620&amp;guid=69745ec9e5f149d409fed336bc7f7068&amp;type=3#Kate_Victoria 1_0&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement name="VictoriaDashboard" style="flex-grow: 1; right: 25px; align-items: stretch;">
            <ui:Label text="Mision completada" name="txt_TituloVictoria" style="align-items: stretch; align-self: center;"/>
            <ui:Label text="¡Ruta despejada, excelente trabajo Jack!" name="txt_MensajeVictoria" style="align-items: stretch; align-self: center;"/>
            <ui:VisualElement name="ContenedorEstadisticas" style="flex-grow: 1; position: absolute;"/>
            <ui:Button text="Siguiente Nivel" name="BtnSiguienteNivel"/>
            <ui:Button text="Rejugar Nivel" name="BtnRejugarVictoria"/>
            <ui:Button text="Menú Principal" name="BtnMenuVictoria"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PanelDerrota" style="flex-grow: 1; background-color: rgb(0, 0, 0); bottom: auto; justify-content: center; align-items: center; width: 100%; height: 100%; position: absolute;">
        <ui:VisualElement name="DerrotaKateContenedor" style="flex-grow: 1;">
            <ui:VisualElement name="RetratoKateDerrota" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Dialogos/Kate_Derrota.png?fileID=8944276893333894316&amp;guid=8b9b12ffc1884bb49864e4b4db44d6ca&amp;type=3#Kate_Derrota_0&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement name="DerrotaDashboard" style="flex-grow: 1; right: 25px;">
            <ui:Label text="MISION FALLIDA" name="txt_TituloDerrota" style="align-self: center;"/>
            <ui:Label text="¡DERROTA!" name="txt_Motivo" style="align-self: center; font-size: 24px; -unity-font-style: bold; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 255, 255); -unity-text-align: upper-center;"/>
            <ui:Button text="Reintentar Nivel" name="BtnReintentar"/>
            <ui:Button text="Menú Principal" name="BtnMenuDerrota"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
